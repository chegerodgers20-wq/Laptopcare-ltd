rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone can read products (that's the public storefront).
    // Only a signed-in admin (present in /admins/{uid}) can write.
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null &&
                      exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // The admins collection itself: readable only by the admin it
    // belongs to (so admin.js can check "am I an admin"), never
    // writable from the client. Add/remove admins from the
    // Firebase Console → Firestore, not from the app.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}